# =============================================================================
# Spotify Blend -> Apple Music Sync Configuration
# Copy this file to .env and fill in API_TOKEN (setup_linux.sh generates one).
# =============================================================================

# Canonical Spotify Blend playlist URL
SPOTIFY_BLEND_URL=https://open.spotify.com/playlist/37i9dQZF1EJzoGIrop9Bz9

# Comma-separated identifiers for YOU (username, user ID, and/or display name)
MY_IDENTIFIERS=xeldev

# Comma-separated identifiers for YOUR PARTNER (user ID from profile URL + display name)
PARTNER_IDENTIFIERS=inubjkdj3pq8nlty5hztmoq5l,Lina

# Set to true to IGNORE songs attributed to BOTH you and your partner.
# Set to false to INCLUDE shared songs (while still skipping songs attributed only to you).
IGNORE_SHARED_SONGS=true

# Path to Playwright storage state exported by scripts/mac_login.py
STORAGE_STATE_PATH=data/storage_state.json

# SQLite database path
DB_PATH=data/blend_sync.db

# Run headless Chromium (true on Linux server; set false only for local desktop debugging)
HEADLESS=true

# Optional custom directory for Playwright browsers (useful if root / disk is small)
# PLAYWRIGHT_BROWSERS_PATH=/mnt/external_hdd/ms-playwright

# Use Xvfb virtual display if available (helps avoid HeadlessChrome detection on Linux)
# Leave empty for auto/default headless mode.
SCROLL_PAUSE_MS=700
MAX_SCROLL_STEPS=60

# =============================================================================
# Secure HTTP API Server (for Apple Shortcuts via Caddy on yxhyai.com)
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8787

# Strong random Bearer token (>= 24 chars). Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=CHANGE_ME_GENERATE_A_LONG_RANDOM_TOKEN_HERE

# =============================================================================
# Optional Push Alerts when Spotify cookies expire or scraping fails
# =============================================================================
# Option 1 (Easiest): ntfy.sh topic URL, e.g. https://ntfy.sh/your-secret-topic-name
NTFY_TOPIC_URL=

# Option 2: Discord or generic JSON webhook URL (sends {"content": "...", "text": "..."})
ALERT_WEBHOOK_URL=

# Minimum hours between repeated expiry alerts for the same outage
ALERT_COOLDOWN_HOURS=24
