[Unit]
Description=Spotify Blend to Apple Music HTTP API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yxhyai
WorkingDirectory=/home/yxhyai/spotify-blend-sync
ExecStart=/usr/bin/python3 -m blend_sync.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
